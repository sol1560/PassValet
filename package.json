{
  "name": "passvalet",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev:desktop": "pnpm --filter @passvalet/desktop tauri dev",
    "build:desktop": "pnpm --filter @passvalet/desktop tauri build",
    "dev:extension": "pnpm --filter @passvalet/extension dev",
    "build:extension": "pnpm --filter @passvalet/extension build",
    "typecheck": "pnpm -r typecheck",
    "test:e2e:desktop": "bash scripts/test-desktop.sh",
    "gen:protocol": "cargo test -p passvalet-ipc --features ts export_bindings"
  },
  "devDependencies": {
    "@wdio/cli": "9.31.9",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-service": "1.4.0",
    "typescript": "^5.9.0"
  }
}
